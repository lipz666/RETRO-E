.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Raw model outputs, derived target splits, ledgers, manifests, metrics and contexts are all
# published: the point of this repository is that every number in the reports can be traced
# back to the record it came from. Only two things are excluded.

# 1. Secrets.
#    (.env above)

# 2. The source dataset. PaRoutes 2.0 n1 is third-party data with its own citable DOI
#    (10.5281/zenodo.7341155), 61 MB for one file. Republishing a copy would burden every
#    clone without adding anything: the protocol manifests record its sha256, so anyone can
#    verify they fetched the same bytes. See docs/RUNBOOK.md for how to obtain it.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
